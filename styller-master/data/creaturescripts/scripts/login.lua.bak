function onLogin(player)
    local loginStr = "Bem vindo ao MARLEYOT!"
    if player:getLastLoginSaved() <= 0 then
        loginStr = loginStr .. " Prepare-se para sua jornada."
    else
        loginStr = loginStr .. " Bem vindo de volta!"
    end
    player:sendTextMessage(MESSAGE_STATUS_DEFAULT, loginStr)
    return true
end
